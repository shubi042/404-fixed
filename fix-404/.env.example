# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Get from: https://dashboard.stripe.com/webhooks
# Set webhook endpoint to: https://yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# The email address that receives booking notifications
OWNER_NOTIFICATION_EMAIL=services@tidymate.ca

# The email address used as sender (must be verified in Resend)
FROM_EMAIL=noreply@tidymate.ca

# Where contact form emails are sent
CONTACT_TO_EMAIL=services@tidymate.ca

# ── Site URL ──────────────────────────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://tidymate.ca

# ── Contractors ───────────────────────────────────────────────────────────────
# Real email addresses for each contractor
CONTRACTOR_1_EMAIL=contractor1@example.com
CONTRACTOR_2_EMAIL=contractor2@example.com
CONTRACTOR_3_EMAIL=contractor3@example.com
CONTRACTOR_4_EMAIL=contractor4@example.com

# ── Google Sheets (optional) ──────────────────────────────────────────────────
# If not set, bookings are logged to console only
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=